{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🚀【一斉】起動 & アタッチ（秘書 → 全部署。最後に秘書へ接続。最初にこれ）",
      "type": "shell",
      "command": "wsl.exe -e bash -ic 'cd \"<YOUR_PATH>\" && ./start-secretariat.sh --no-attach && ./start-agents-all.sh && tmux attach -t =brain-company-secretariat'",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "🎧【秘書】秘書だけ起動 & アタッチ（部署は起こさない。起動中なら接続だけ）",
      "type": "shell",
      "command": "wsl.exe -e bash -ic 'cd \"<YOUR_PATH>\" && ./start-secretariat.sh'",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "🔁【秘書】再起動（終了 → 最新の会話から起動 & アタッチ）",
      "type": "shell",
      "command": "wsl.exe -e bash -ic 'cd \"<YOUR_PATH>\" && tmux kill-session -t =brain-company-secretariat 2>/dev/null; sleep 1; ./start-secretariat.sh'",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "🚀【tmux】PM+開発+watcher 起動 & アタッチ（秘書は別途）",
