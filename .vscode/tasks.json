    {
      "label": "🎧【秘書】独立起動（最初にこれ）",
      "type": "shell",
      "command": "wsl.exe",
      "args": [
        "bash", "-ic",
        "cd <YOUR_PATH>/secretariat && claude --dangerously-skip-permissions"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
