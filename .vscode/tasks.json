      "command": "wsl.exe -e bash -ic 'cd \"<YOUR_PATH>\" && ./start-agents.sh && tmux attach -t =brain-company'",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "🏢【tmux】全部署 一斉起動 & アタッチ（秘書は別途）",
      "type": "shell",
      "command": "wsl.exe -e bash -ic 'cd \"<YOUR_PATH>\" && ./start-agents-all.sh && tmux attach -t =brain-company'",
