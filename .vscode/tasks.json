        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "🔗【tmux】部署の窓にアタッチのみ（既に起動中の場合）",
      "type": "shell",
      "command": "wsl.exe -e bash -ic 'tmux attach -t =brain-company'",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "🛑【一斉】停止（全部署 → 秘書）",
      "type": "shell",
      "command": "wsl.exe -e bash -ic 'tmux kill-session -t =brain-company 2>/dev/null; tmux kill-session -t =brain-company-secretariat 2>/dev/null; tmux ls 2>/dev/null; echo stopped'",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "🧩【秘書】extractor 窓の補完（落ちた時だけ・秘書のセッションは落とさない）",
      "type": "shell",
      "command": "wsl.exe -e bash -ic 'cd \"<YOUR_PATH>\" && ./start-secretariat.sh --no-attach'",
