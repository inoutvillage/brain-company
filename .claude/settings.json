{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Write",
      "Edit",
      "NotebookEdit",
      "Bash(ls*)",
      "Bash(mkdir*)",
      "Bash(touch*)",
      "Bash(find*)",
      "Bash(grep*)",
      "Bash(cat*)",
      "Bash(head*)",
      "Bash(tail*)",
      "Bash(pwd*)",
      "Bash(echo*)",
      "Bash(stat*)",
      "Bash(which*)",
      "Bash(cd*)",
      "Bash(date*)",
      "Bash(chmod*)",
      "Bash(cp*)",
      "Bash(mv*)",
      "Bash(wc*)",
      "Bash(sort*)",
      "Bash(uniq*)",
      "Bash(awk*)",
      "Bash(sed*)",
      "Bash(diff*)",
      "Bash(tmux*)",
      "Bash(tr*)",
      "Bash(xargs*)",
      "Bash(tee*)",
      "Bash(basename*)",
      "Bash(dirname*)",
      "Bash(realpath*)",
      "Bash(readlink*)",
      "Bash(ln -s*)",
      "Bash(file*)",
      "Bash(cut*)",
      "Bash(env*)",
      "Bash(test*)",
      "Bash(./*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git branch*)"
    ],
    "ask": [
      "Bash(rm*)",
      "Bash(rmdir*)",
      "Bash(sudo*)",
      "Bash(curl*)",
      "Bash(wget*)",
      "Bash(git push*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(git checkout*)",
      "Bash(dnf install*)",
      "Bash(dnf remove*)",
      "Bash(dnf update*)",
      "Bash(apt install*)",
      "Bash(apt remove*)",
      "Bash(npm install*)",
      "Bash(npm uninstall*)",
      "Bash(npm publish*)",
      "Bash(kill*)",
      "Bash(killall*)",
      "Bash(pkill*)",
      "Bash(chown*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/.secret/**)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(//home/*/.ssh/**)",
      "Read(//home/*/.aws/credentials)",
      "Read(//home/*/.aws/config)",
      "Read(//home/*/.gnupg/**)",
      "Read(//home/*/.config/gcloud/**)",
      "Read(//root/**)",
      "Read(/etc/shadow)",
      "Read(/etc/sudoers)",
      "Read(/etc/ssh/**)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf $HOME*)",
      "Bash(sudo rm -rf *)",
      "Bash(sudo rm -rf /*)",
      "Bash(dd if=*of=/dev/*)",
      "Bash(dd if=/dev/zero*)",
      "Bash(mkfs*)",
      "Bash(mkfs.*)",
      "Bash(fdisk*)",
      "Bash(parted*)",
      "Bash(curl * | sh*)",
      "Bash(curl * | bash*)",
      "Bash(wget * | sh*)",
      "Bash(wget * | bash*)",
      "Bash(eval *curl*)",
      "Bash(chmod 777 /*)",
      "Bash(chmod -R 777 /*)",
      "Bash(> /dev/sda*)",
      "Bash(shred*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/log-tool-usage.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/log-bash-exec.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/on-stop.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/log-user-prompt.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/log-assistant-response.sh"
          }
        ]
      }
    ]
  }
}
